# Local development values only. Do not use these values outside a local machine.
POSTGRES_DB=railway
POSTGRES_USER=railway
POSTGRES_PASSWORD=railway_dev_only
POSTGRES_PORT=5432

REDIS_PORT=6379

MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_TRAINING_ROWS=1200
TICKET_SERVICE_PORT=8001
DELAY_SERVICE_PORT=8002
FARE_SERVICE_PORT=8003

DATABASE_URL=postgresql+psycopg://railway:railway_dev_only@localhost:5432/railway
REDIS_URL=redis://localhost:6379/0

# Set to a random value of at least 32 characters before issuing JWTs.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
